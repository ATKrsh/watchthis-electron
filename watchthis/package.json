{
  "name": "watchthis",
  "version": "50.0.0",
  "description": "Futuristic, Snappy Desktop Media File Explorer & Advanced Player",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json -w\" \"node wait-and-electron.js\"",
    "electron:build": "npm run build && electron-builder --win",
    "start": "electron ."
  },
  "keywords": [
    "video",
    "player",
    "file-explorer",
    "electron",
    "react",
    "futuristic",
    "fx-explorer",
    "filters"
  ],
  "author": "ATK",
  "license": "MIT",
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.watchthis.app",
    "productName": "WatchThis",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "artifactName": "WatchThis_v50.${ext}"
    },
    "portable": {
      "artifactName": "WatchThis_v50.exe"
    }
  }














}

